\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Facade setback trade-off (cross-section view). Three candidate setback distances are shown for a 20\,m-deep lot: $d_f = 3$\,m yields 9~floors on 17\,m of depth (blue), $d_f = 7$\,m yields 11~floors on 13\,m (green), and $d_f = 12$\,m yields 13~floors on only 8\,m (red). The optimal $d_f$ balances height gain against footprint loss.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:setback-tradeoff}{{2}{7}{Facade setback trade-off (cross-section view). Three candidate setback distances are shown for a 20\,m-deep lot: $d_f = 3$\,m yields 9~floors on 17\,m of depth (blue), $d_f = 7$\,m yields 11~floors on 13\,m (green), and $d_f = 12$\,m yields 13~floors on only 8\,m (red). The optimal $d_f$ balances height gain against footprint loss}{figure.2}{}}
